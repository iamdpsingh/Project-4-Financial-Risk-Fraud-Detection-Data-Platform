{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Account",
  "type": "object",
  "required": ["account_id", "customer_id", "account_type", "account_status", "currency", "opened_at"],
  "properties": {
    "account_id":      { "type": "string", "format": "uuid" },
    "customer_id":     { "type": "string", "format": "uuid" },
    "account_type":    { "type": "string", "enum": ["checking","savings","credit","loan","investment"] },
    "account_status":  { "type": "string", "enum": ["active","inactive","suspended","closed"] },
    "currency":        { "type": "string", "enum": ["USD","EUR","GBP","INR","JPY","CAD","AUD","SGD","CHF","CNY","HKD","BRL","MXN","AED","SAR"] },
    "opened_at":       { "type": "string", "format": "date-time" },
    "closed_at":       { "type": ["string", "null"], "format": "date-time" },
    "created_at":      { "type": "string", "format": "date-time" },
    "updated_at":      { "type": "string", "format": "date-time" }
  }
}
