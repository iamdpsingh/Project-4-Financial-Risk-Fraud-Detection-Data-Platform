{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Customer",
  "description": "A customer of the financial platform.",
  "type": "object",
  "required": ["customer_id", "name", "email", "country", "customer_segment", "created_at", "updated_at"],
  "properties": {
    "customer_id":       { "type": "string", "format": "uuid" },
    "name":              { "type": "string", "maxLength": 255 },
    "email":             { "type": "string", "format": "email", "maxLength": 320 },
    "phone":             { "type": ["string", "null"], "maxLength": 30 },
    "country":           { "type": "string", "pattern": "^[A-Z]{2}$", "description": "ISO 3166-1 alpha-2" },
    "city":              { "type": ["string", "null"], "maxLength": 100 },
    "customer_segment":  { "type": "string", "enum": ["retail", "premium", "business", "vip", "student"] },
    "date_of_birth":     { "type": ["string", "null"], "format": "date" },
    "created_at":        { "type": "string", "format": "date-time" },
    "updated_at":        { "type": "string", "format": "date-time" }
  },
  "additionalProperties": false
}
