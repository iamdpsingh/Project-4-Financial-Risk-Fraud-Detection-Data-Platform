{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Merchant",
  "type": "object",
  "required": ["merchant_id", "merchant_name", "merchant_category", "country", "risk_category"],
  "properties": {
    "merchant_id":       { "type": "string", "format": "uuid" },
    "merchant_name":     { "type": "string", "maxLength": 255 },
    "merchant_category": { "type": "string", "maxLength": 100 },
    "mcc_code":          { "type": ["string", "null"], "pattern": "^[0-9]{4}$" },
    "country":           { "type": "string", "pattern": "^[A-Z]{2}$" },
    "city":              { "type": ["string", "null"], "maxLength": 100 },
    "risk_category":     { "type": "string", "enum": ["low", "medium", "high"] },
    "created_at":        { "type": "string", "format": "date-time" },
    "updated_at":        { "type": "string", "format": "date-time" }
  }
}
