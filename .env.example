# ─────────────────────────────────────────────────────────────────────────────
# Environment Variables — Copy this file to .env and fill in your values.
# Never commit .env to version control.
# ─────────────────────────────────────────────────────────────────────────────

# ── Project Identity ──────────────────────────────────────────────────────────
PROJECT_NAME=financial-risk-fraud-platform
ENVIRONMENT=local   # local | staging | production

# ── GCP ───────────────────────────────────────────────────────────────────────
GCP_PROJECT_ID=your-gcp-project-id
GCP_REGION=us-central1
GCP_ZONE=us-central1-a
GCP_BILLING_ACCOUNT=your-billing-account-id   # format: XXXXXX-XXXXXX-XXXXXX

# ── GCS Bucket ────────────────────────────────────────────────────────────────
GCS_BUCKET_NAME=financial-risk-platform-${GCP_PROJECT_ID}
GCS_RAW_PREFIX=raw
GCS_PROCESSED_PREFIX=processed
GCS_QUARANTINE_PREFIX=quarantine
GCS_ARCHIVE_PREFIX=archive

# ── BigQuery ──────────────────────────────────────────────────────────────────
BQ_DATASET_RAW=raw
BQ_DATASET_STAGING=staging
BQ_DATASET_CORE=core
BQ_DATASET_ANALYTICS=analytics

# ── Pub/Sub ───────────────────────────────────────────────────────────────────
PUBSUB_TOPIC_TRANSACTIONS=transaction-events
PUBSUB_TOPIC_DEAD_LETTER=transaction-dead-letter
PUBSUB_SUBSCRIPTION_DATAFLOW=transaction-events-dataflow-sub

# ── Pub/Sub Emulator (local development) ─────────────────────────────────────
PUBSUB_EMULATOR_HOST=localhost:8085

# ── PostgreSQL (local) ────────────────────────────────────────────────────────
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=financial_risk
POSTGRES_USER=fraud_user
POSTGRES_PASSWORD=change_me_in_local_env

# ── Cloud Run ─────────────────────────────────────────────────────────────────
CLOUD_RUN_SERVICE_NAME=transaction-ingestion-api
CLOUD_RUN_REGION=us-central1

# ── Dataflow ──────────────────────────────────────────────────────────────────
DATAFLOW_TEMP_LOCATION=gs://${GCS_BUCKET_NAME}/dataflow-temp
DATAFLOW_STAGING_LOCATION=gs://${GCS_BUCKET_NAME}/dataflow-staging
DATAFLOW_SERVICE_ACCOUNT=dataflow-sa@${GCP_PROJECT_ID}.iam.gserviceaccount.com

# ── Artifact Registry ─────────────────────────────────────────────────────────
ARTIFACT_REGISTRY_REGION=us-central1
ARTIFACT_REGISTRY_REPO=financial-risk-platform
DOCKER_IMAGE_INGESTION_API=${ARTIFACT_REGISTRY_REGION}-docker.pkg.dev/${GCP_PROJECT_ID}/${ARTIFACT_REGISTRY_REPO}/ingestion-api

# ── Data Generation ───────────────────────────────────────────────────────────
NUM_CUSTOMERS=10000
NUM_ACCOUNTS=15000
NUM_MERCHANTS=2000
NUM_DEVICES=20000
NUM_TRANSACTIONS=500000
NUM_EVENTS=1500000
RANDOM_SEED=42

# ── Risk Scoring Thresholds ───────────────────────────────────────────────────
RISK_LOW_MAX=30
RISK_MEDIUM_MAX=70
# RISK_HIGH = 71–100

# ── Monitoring & Alerting ─────────────────────────────────────────────────────
ALERT_EMAIL=your-email@example.com
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/...   # optional

# ── Service Account Key Paths (local only — never commit the actual key) ──────
GOOGLE_APPLICATION_CREDENTIALS=./secrets/service-account-key.json
